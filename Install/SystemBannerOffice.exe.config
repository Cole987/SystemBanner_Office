<?xml version="1.0"?>
<!-- Written by the SystemBanner Office add-in installer, removed by RemoveSystemBannerOffice.bat.
     Office 2000 to 2003 start the .NET runtime of their first managed add-in, which can be .NET 1.1:
     the SystemBanner add-in needs .NET 2.0, and add-ins written for .NET 1.1 usually run on it. -->
<configuration>
  <startup>
    <supportedRuntime version="v2.0.50727"/>
    <supportedRuntime version="v1.1.4322"/>
  </startup>
</configuration>
